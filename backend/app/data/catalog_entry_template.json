{
  "version": 3,
  "milestone": "C.1a",
  "how_to_use": [
    "1. Read backend/docs/CROSS_BRAND_DATA_WORKSHEET.md first (human-friendly guide).",
    "2. Open an official product page in your browser (do not scrape).",
    "3. Fill one object in cross_brand_shades_worksheet — ONLY what you see on the page.",
    "4. Leave unknown fields as null — never guess depth/undertone.",
    "5. For ambiguous bands (light-medium, medium-deep), keep brand_reported_depth null and put the brand words in brand_depth_band + brand_shade_description / uncertainty_notes.",
    "6. Keep metadata_verification_status as unreviewed until you personally check the source.",
    "7. Keep matching_accuracy_status as not_evaluated until real wear/gold-set evidence exists.",
    "8. Set verification_status to brand_verified only after source_checked AND accurate brand text.",
    "9. Do NOT paste into foundation_catalog.json until Milestone C.1b review.",
    "10. brand_depth_band is worksheet-only (not a live catalog field). Move that text into uncertainty_notes or brand_shade_description before C.1b paste.",
    "11. Preserve the five existing NARS rows and all ShadeWise Demo test rows in foundation_catalog.json."
  ],
  "reference_product_pages": {
    "nars_light_reflecting_foundation": "https://www.narscosmetics.com/USA/light-reflecting%E2%84%A2-advanced-skincare-foundation/999NAC0000141.html",
    "maybelline_fit_me_matte_poreless": "https://www.maybelline.com/face-makeup/foundation-makeup/fit-me-matte-poreless-foundation",
    "fenty_pro_filtr_soft_matte": "https://fentybeauty.com/products/pro-filtr-soft-matte-longwear-foundation",
    "fenty_shade_finder_optional": "https://fentybeauty.com/pages/fenty-face-shade-finder"
  },
  "allowed_values": {
    "brand_reported_depth_or_independent_depth": ["fair", "light", "medium", "tan", "deep", null],
    "brand_reported_undertone_or_independent_undertone": ["cool", "warm", "neutral", "olive", null],
    "verification_status": ["brand_verified", "independently_measured", "estimated", "illustrative"],
    "metadata_verification_status": ["illustrative", "unreviewed", "source_checked"],
    "matching_accuracy_status": ["not_evaluated", "insufficient_evidence", "wear_validated"],
    "brand_depth_band_worksheet_only": "Free text for ambiguous brand bands (e.g. light-medium). Not loaded into FoundationShade."
  },
  "verification_reminder": {
    "metadata_verification_status": "Did a human check brand/product/shade labels against the official page?",
    "matching_accuracy_status": "Do we have evidence this shade is a good match recommendation? Usually not_evaluated until wear tests.",
    "do_not_confuse": "source_checked metadata is NOT proof of matching accuracy."
  },
  "collection_plan": {
    "goal_real_shades_total": "18-24",
    "already_in_live_catalog": {
      "nars_light_reflecting": 5,
      "note": "Fiji, Punjab, Patagonia, Santa Fe, Stromboli — do not duplicate."
    },
