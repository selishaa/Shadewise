{
  "version": 2,
  "how_to_use": [
    "1. Copy one object from the 'entry_template' example below.",
    "2. Open the official product page in your browser (do not scrape).",
    "3. Fill ONLY what you can see on the page or packaging.",
    "4. Leave unknown fields as null — never guess.",
    "5. Keep metadata_verification_status as 'unreviewed' until you personally check the source.",
    "6. Keep matching_accuracy_status as 'not_evaluated' until real wear/gold-set evidence exists.",
    "7. Set verification_status to 'brand_verified' only after source_checked metadata AND you copied brand text accurately.",
    "8. Paste finished rows into foundation_catalog.json 'shades' array, then run: pytest -q",
    "9. Restart the backend (or call reload) so the cache refreshes."
  ],
