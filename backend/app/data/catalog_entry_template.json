    },
    "planned_totals_after_c1b": {
      "nars": 8,
      "maybelline": 8,
      "fenty": 8,
      "real_shades_approx": 24
    },
    "depth_balance_targets": {
      "fair": "3-4 shades across brands",
      "light": "4-5",
      "medium": "5-6 (several NARS mediums already exist)",
      "tan": "3-4",
      "deep": "3-4"
    },
    "ambiguous_depth_rule": "If the brand says light-medium, medium-deep, or light to medium, leave brand_reported_depth null. Record exact wording in brand_depth_band (worksheet) and brand_shade_description / uncertainty_notes."
  },
